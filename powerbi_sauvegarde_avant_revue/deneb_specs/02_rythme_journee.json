{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "name": "dataset"
  },
  "padding": {
    "top": 10,
    "left": 6,
    "right": 14,
    "bottom": 6
  },
  "transform": [
    {
      "calculate": "datum.n_service > 0 ? datum.n_penurie / datum.n_service : null",
      "as": "penurie"
    },
    {
      "calculate": "datum.n_service > 0 ? datum.n_saturation / datum.n_service : null",
      "as": "saturation"
    },
    {
      "fold": [
        "penurie",
        "saturation"
      ],
      "as": [
        "serie",
        "taux"
      ]
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "a": 7,
            "b": 10,
            "t": "pointe du matin"
          },
          {
            "a": 17,
            "b": 20,
            "t": "pointe du soir"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#1F2A40",
        "opacity": 0.75,
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "field": "a",
          "type": "quantitative"
        },
        "x2": {
          "field": "b"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "m": 8.5,
            "t": "pointe du matin"
          },
          {
            "m": 18.5,
            "t": "pointe du soir"
          }
