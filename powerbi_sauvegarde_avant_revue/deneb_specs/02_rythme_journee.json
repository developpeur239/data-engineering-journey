    {
      "transform": [
        {
          "pivot": "serie",
          "value": "taux",
          "groupby": [
            "heure_du_jour"
          ]
        },
        {
          "calculate": "(datum.heure_du_jour < 10 ? '0' : '') + datum.heure_du_jour + ' h – ' + (datum.heure_du_jour + 1 < 10 ? '0' : '') + (datum.heure_du_jour + 1) + ' h'",
          "as": "plage"
        }
      ],
      "params": [
        {
          "name": "survol",
          "select": {
            "type": "point",
            "fields": [
              "heure_du_jour"
            ],
            "nearest": true,
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "color": "#8D9BB6"
      },
      "encoding": {
        "x": {
          "field": "heure_du_jour",
          "type": "quantitative",
