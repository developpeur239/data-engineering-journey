      },
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -8,
        "fontSize": 11,
        "color": "#8D9BB6"
      },
      "encoding": {
        "x": {
          "field": "m",
          "type": "quantitative"
        },
        "y": {
          "value": {
            "expr": "height"
          }
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.serie === 'penurie'"
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "line": false,
        "color": {
          "gradient": "linear",
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "stops": [
            {
              "offset": 0,
              "color": "rgba(226,104,40,0)"
            },
            {
              "offset": 1,
              "color": "rgba(226,104,40,0.38)"
            }
          ]
        },
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "heure_du_jour",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              23
            ],
            "nice": false
          },
          "axis": {
