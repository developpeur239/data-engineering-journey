          }
        },
        "opacity": {
          "condition": {
            "param": "survol",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "plage",
            "type": "nominal",
            "title": "Heure (Paris)"
          },
          {
            "field": "penurie",
            "type": "quantitative",
            "title": "Pénurie",
            "format": ".1%"
