	column pluie_libelle = IF(gold_station_heure[il_pleut] = TRUE(), "Pluie", "Sans pluie")
		dataType: string
		isDataTypeInferred
		lineageTag: 8d6de83d-9bf0-542f-a766-4279be26d9f7
