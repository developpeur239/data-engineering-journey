		annotation SummarizationSetBy = User

	column jour_nom = SWITCH(gold_station_heure[jour_semaine_ordre], 1, "lundi", 2, "mardi", 3, "mercredi", 4, "jeudi", 5, "vendredi", 6, "samedi", 7, "dimanche")
		dataType: string
		isDataTypeInferred
		lineageTag: 8f3cd802-198e-5f38-933b-6cade4c77bb7
