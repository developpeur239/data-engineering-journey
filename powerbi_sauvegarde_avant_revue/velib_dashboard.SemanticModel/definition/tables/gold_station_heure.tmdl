table gold_station_heure
	lineageTag: 1bb73172-641d-551e-bbbd-979b824a823c

	measure 'Nb stations' = DISTINCTCOUNT(gold_station_heure[station_id])
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: 9e80284e-3e92-5b73-b63b-d9ed34a2bcc7

	measure 'Taux pénurie' = DIVIDE(SUM(gold_station_heure[nb_releves_penurie]), SUM(gold_station_heure[nb_releves_en_service]))
		formatString: 0.0%
		displayFolder: Indicateurs
		lineageTag: ecb930b7-23ed-5e78-8684-3460137f5dad

	measure 'Taux saturation' = DIVIDE(SUM(gold_station_heure[nb_releves_saturation]), SUM(gold_station_heure[nb_releves_en_service]))
		formatString: 0.0%
		displayFolder: Indicateurs
		lineageTag: f09c4e98-c3c0-5b9f-830b-93966d2becd6

	measure 'Dernière heure' = MAX(gold_station_heure[heure_paris])
		formatString: dd/MM HH:mm
		displayFolder: Indicateurs
		lineageTag: 333d815a-9f9f-5ce5-a774-90db5d090deb

	measure 'Taux pénurie avec panne' = CALCULATE([Taux pénurie], gold_station_heure[station_proche_ferre_300m] = TRUE(), gold_station_heure[panne_ferree_300m] = TRUE())
		formatString: 0.0%
		displayFolder: Pannes
		lineageTag: 07c419cd-116b-5eec-94c9-a86f31f4ed2a

	measure 'Taux pénurie sans panne' = CALCULATE([Taux pénurie], REMOVEFILTERS(gold_station_heure[panne_ferree_imprevue_300m]), gold_station_heure[station_proche_ferre_300m] = TRUE(), gold_station_heure[panne_ferree_300m] = FALSE())
		formatString: 0.0%
		displayFolder: Pannes
		lineageTag: b6a20b2b-bd87-53fa-bdbb-1a6eeccf8af9

	measure 'Taux saturation avec panne' = CALCULATE([Taux saturation], gold_station_heure[station_proche_ferre_300m] = TRUE(), gold_station_heure[panne_ferree_300m] = TRUE())
		formatString: 0.0%
		displayFolder: Pannes
		lineageTag: eb2444eb-2d96-5a1d-93f8-4413c0bbe944

	measure 'Taux saturation sans panne' = CALCULATE([Taux saturation], REMOVEFILTERS(gold_station_heure[panne_ferree_imprevue_300m]), gold_station_heure[station_proche_ferre_300m] = TRUE(), gold_station_heure[panne_ferree_300m] = FALSE())
		formatString: 0.0%
		displayFolder: Pannes
		lineageTag: 72b93763-8b22-5c59-a869-56d75ff382c6

	measure 'Écart pénurie (pts)' = ([Taux pénurie avec panne] - [Taux pénurie sans panne]) * 100
		formatString: "+0.0"" pts"";-0.0"" pts"";0.0"" pts"""
		displayFolder: Pannes
		lineageTag: fb244750-7e99-504f-a533-f57058c398ed

	measure 'Écart saturation (pts)' = ([Taux saturation avec panne] - [Taux saturation sans panne]) * 100
		formatString: "+0.0"" pts"";-0.0"" pts"";0.0"" pts"""
		displayFolder: Pannes
		lineageTag: 1909b31c-bde2-5d1b-b08f-63cf160992c2

	measure 'Part heures avec panne ferrée' = DIVIDE(CALCULATE(COUNTROWS(gold_station_heure), gold_station_heure[station_proche_ferre_300m] = TRUE(), gold_station_heure[panne_ferree_300m] = TRUE()), CALCULATE(COUNTROWS(gold_station_heure), REMOVEFILTERS(gold_station_heure[panne_ferree_imprevue_300m]), gold_station_heure[station_proche_ferre_300m] = TRUE()))
		formatString: 0.0%
		displayFolder: Pannes
		lineageTag: f06b3904-6a34-52d1-b86b-0bd718dcc294

	measure n_service = SUM(gold_station_heure[nb_releves_en_service])
		formatString: #,0
		isHidden
		displayFolder: Appui Deneb
		lineageTag: afb0b414-37a9-5e6d-ac08-44a3ac4e46df

	measure n_penurie = SUM(gold_station_heure[nb_releves_penurie])
		formatString: #,0
		isHidden
		displayFolder: Appui Deneb
		lineageTag: 97dae26e-2d6e-53cc-914e-a57de211f324

	measure n_saturation = SUM(gold_station_heure[nb_releves_saturation])
		formatString: #,0
		isHidden
		displayFolder: Appui Deneb
		lineageTag: 10d18681-544b-5fd8-a85d-08a8fd48ef37

	measure capacite_max = MAX(gold_station_heure[capacite])
		formatString: 0
		isHidden
		displayFolder: Appui Deneb
		lineageTag: 82ccb857-ab9c-5963-a16f-962b099d1296

	measure seuil_temperature = CALCULATE(AVERAGE(gold_station_heure[temperature_c]), ALLSELECTED(gold_station_heure[heure_paris]), ALLSELECTED(gold_station_heure[temperature_c]), ALLSELECTED(gold_station_heure[pluie_libelle]))
		formatString: 0.0
		isHidden
		displayFolder: Appui Deneb
		lineageTag: 4b31bdb6-0d42-58d3-ae84-7b1e254927bd

	measure lon_moy = AVERAGE(gold_station_heure[longitude])
		formatString: 0.00000
		isHidden
		displayFolder: Appui natif
		lineageTag: 4552a83e-c0a9-5146-9f05-3c9d07c5b5c9

	measure lat_moy = AVERAGE(gold_station_heure[latitude])
		formatString: 0.00000
		isHidden
		displayFolder: Appui natif
		lineageTag: ca372db7-4662-5305-b3f4-437f28da4da4

	measure temperature_moy = AVERAGE(gold_station_heure[temperature_c])
		formatString: 0.0
		isHidden
		displayFolder: Appui natif
		lineageTag: 144c8d6d-90f7-56ef-9aed-491fc723010b

	measure 'Titre heatmap' =
			VAR t = ADDCOLUMNS(
			    SUMMARIZE(gold_station_heure, gold_station_heure[heure_du_jour], gold_station_heure[jour_semaine_ordre], gold_station_heure[jour_nom]),
			    "@r", [Taux pénurie])
			VAR m = TOPN(1, t, [@r], DESC)
			VAR h = MAXX(m, gold_station_heure[heure_du_jour])
			VAR j = MAXX(m, gold_station_heure[jour_nom])
			RETURN IF(ISBLANK(h), "Où et quand manque-t-on de vélos ?", "Les pénuries culminent le " & j & " à " & h & " h")
		isHidden
		displayFolder: Titres
		lineageTag: ff495395-c489-5d51-b33d-0373651fec7d

	measure 'Titre rythme' =
			VAR t = ADDCOLUMNS(VALUES(gold_station_heure[heure_du_jour]), "@r", [Taux pénurie])
			VAR m = TOPN(1, t, [@r], DESC)
			VAR h = MAXX(m, gold_station_heure[heure_du_jour])
			RETURN IF(ISBLANK(h), "Les pénuries au fil de la journée", "Les pénuries explosent à " & h & " h")
		isHidden
		displayFolder: Titres
		lineageTag: ad8d7acf-84c0-56ec-956b-58a41091be8d

	measure 'Titre carte' =
			VAR t = ADDCOLUMNS(VALUES(gold_station_heure[station_id]), "@r", [Taux pénurie])
			VAR n = COUNTROWS(FILTER(t, [@r] > 0.2))
			VAR total = COUNTROWS(t)
			RETURN IF(total = 0, "Quelles stations manquent de vélos ?",
			    FORMAT(n, "#,##0", "fr-FR") & " stations sur " & FORMAT(total, "#,##0", "fr-FR") & " sont vides plus d'un relevé sur cinq")
		isHidden
		displayFolder: Titres
		lineageTag: 1e66d693-be3e-51e2-aa83-04f0dc402794

	measure 'Titre pannes' =
			VAR e = CALCULATE([Écart pénurie (pts)], gold_station_heure[heure_de_pointe] = TRUE())
			RETURN IF(ISBLANK(e), "Une panne ferrée à proximité change-t-elle la pénurie ?",
			    "En heure de pointe, une panne ferrée à moins de 300 m " & IF(e >= 0, "augmente", "réduit")
			    & " la pénurie de " & FORMAT(ABS(e), "0.0", "fr-FR") & " pts")
		isHidden
		displayFolder: Titres
		lineageTag: 8e570b2f-a966-5172-8593-e68dedc532e1

	measure 'Titre pluie' =
			VAR a = CALCULATE([Taux pénurie], gold_station_heure[il_pleut] = FALSE())
			VAR b = CALCULATE([Taux pénurie], gold_station_heure[il_pleut] = TRUE())
			RETURN IF(ISBLANK(a) || ISBLANK(b), "Pénurie et saturation, avec et sans pluie",
			    "Sous la pluie, la pénurie passe de " & FORMAT(a, "0.0%", "fr-FR") & " à " & FORMAT(b, "0.0%", "fr-FR"))
		isHidden
		displayFolder: Titres
		lineageTag: c6bfe188-0ae0-5169-90c8-b41bf7c8c692

	measure 'Titre nuage' =
			VAR seuil = [seuil_temperature]
			VAR chaud = CALCULATE([Taux pénurie], gold_station_heure[temperature_c] >= seuil)
			VAR froid = CALCULATE([Taux pénurie], gold_station_heure[temperature_c] < seuil)
			RETURN IF(ISBLANK(seuil) || ISBLANK(chaud) || ISBLANK(froid), "La pénurie varie-t-elle avec la température ?",
			    "Au-dessus de " & FORMAT(seuil, "0.0", "fr-FR") & " °C, la pénurie est de " & FORMAT(chaud, "0.0%", "fr-FR")
			    & " contre " & FORMAT(froid, "0.0%", "fr-FR") & " en dessous")
		isHidden
		displayFolder: Titres
		lineageTag: e3dadcbe-48a4-592c-8f36-65fb24e48025

	measure 'Titre courbes' =
			VAR t = ADDCOLUMNS(VALUES(gold_station_heure[heure_du_jour]),
			    "@p", CALCULATE([Taux pénurie], gold_station_heure[il_pleut] = TRUE()),
			    "@s", CALCULATE([Taux pénurie], gold_station_heure[il_pleut] = FALSE()))
			VAR comparables = FILTER(t, NOT ISBLANK([@p]) && NOT ISBLANK([@s]))
			VAR total = COUNTROWS(comparables)
			VAR plus = COUNTROWS(FILTER(comparables, [@p] > [@s]))
			RETURN IF(total = 0, "À chaque heure, la pluie change-t-elle la pénurie ?",
			    "Sous la pluie, la pénurie est plus haute à " & FORMAT(plus, "#,##0", "fr-FR") & " heures sur " & FORMAT(total, "#,##0", "fr-FR"))
		isHidden
		displayFolder: Titres
		lineageTag: c2d3efac-d072-5d54-b84d-288d5cabded4

