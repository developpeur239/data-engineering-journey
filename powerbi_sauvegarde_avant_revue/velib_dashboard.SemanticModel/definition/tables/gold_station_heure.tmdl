		annotation SummarizationSetBy = User

	partition gold_station_heure = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs(Hote, CheminHTTP, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),
				    Catalogue_ = Source{[Name = Catalogue, Kind = "Database"]}[Data],
				    Schema_ = Catalogue_{[Name = "velib", Kind = "Schema"]}[Data],
				    Table_ = Schema_{[Name = "gold_station_heure", Kind = "Table"]}[Data],
				    SansFuseau = Table.TransformColumns(Table_, {
				            {"heure_utc", each if _ is datetimezone then DateTimeZone.RemoveZone(_) else _, type datetime},
				            {"heure_paris", each if _ is datetimezone then DateTimeZone.RemoveZone(_) else _, type datetime}
				        }),
				    Types = Table.TransformColumnTypes(SansFuseau, {
				            {"station_id", type text},
				            {"station_nom", type text},
				            {"station_code", type text},
				            {"latitude", type number},
				            {"longitude", type number},
				            {"capacite", Int64.Type},
				            {"heure_utc", type datetime},
				            {"heure_paris", type datetime},
				            {"date_paris", type date},
				            {"heure_du_jour", Int64.Type},
				            {"jour_semaine", type text},
				            {"est_weekend", type logical},
				            {"heure_de_pointe", type logical},
				            {"nb_releves", Int64.Type},
				            {"nb_releves_en_service", Int64.Type},
				            {"nb_releves_penurie", Int64.Type},
				            {"nb_releves_saturation", Int64.Type},
				            {"taux_penurie", type number},
				            {"taux_saturation", type number},
				            {"velos_moyens", type number},
				            {"velos_electriques_moyens", type number},
				            {"places_libres_moyennes", type number},
				            {"temperature_c", type number},
				            {"precipitation_mm", type number},
				            {"il_pleut", type logical},
				            {"station_proche_ferre_300m", type logical},
				            {"panne_ferree_300m", type logical},
				            {"panne_ferree_500m", type logical},
				            {"panne_ferree_bloquante_300m", type logical},
				            {"panne_ferree_imprevue_300m", type logical},
				            {"panne_bus_300m", type logical},
				            {"nb_pannes_ferrees_300m", Int64.Type},
				            {"distance_min_panne_ferree_m", type number}
				        }, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
