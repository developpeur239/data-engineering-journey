                "textRuns": [
                  {
                    "value": "Méthode et limites",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "16pt",
                      "fontWeight": "600",
                      "color": "#EAF0FA"
