                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Passages par compteur : moyenne des comptages par compteur actif, car le nombre de compteurs varie d'une année à l'autre.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#A9B6CE"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "À conditions égales : on compare pluie et temps sec à la même heure, pour le même type de jour et la même saison, puis on pondère par le nombre d'heures de pluie (au moins 5 par groupe).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#A9B6CE"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Jours fériés et vacances scolaires ne sont pas exclus. Un seul point météo pour tout Paris.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#A9B6CE"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Association, pas causalité : la météo n'explique pas à elle seule les écarts.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#EAF0FA"
                    }
                  }
                ]
              }
            ]
          }
