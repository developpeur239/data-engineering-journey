{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "name": "dataset"
  },
  "padding": {
    "top": 10,
    "left": 6,
    "right": 14,
    "bottom": 6
  },
  "transform": [
    {
      "calculate": "timeFormat(toDate(datum.heure_paris), '%d/%m %Hh')",
      "as": "quand"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "survol",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": [
              "heure_paris"
            ]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "size": 70,
        "stroke": "#161E2E",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "temperature_c",
          "type": "quantitative",
          "scale": {
            "zero": false
          },
          "axis": {
            "title": null,
            "grid": false,
            "labelExpr": "datum.value + ' °C'"
          }
        },
        "y": {
          "field": "Taux pénurie",
          "type": "quantitative",
          "scale": {
            "domainMin": 0
          },
          "axis": {
            "format": ".0%",
            "title": null,
            "tickCount": 4
          }
        },
        "color": {
          "field": "pluie_libelle",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sans pluie",
              "Pluie"
            ],
            "range": [
              "#9AA9C4",
              "#7F6AE6"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-right",
            "direction": "horizontal",
            "offset": 4,
            "fillColor": "#161E2E",
            "padding": 6,
            "cornerRadius": 6
          }
        },
        "opacity": {
          "condition": {
            "param": "survol",
            "value": 0.95
          },
          "value": 0.55
        },
        "tooltip": [
          {
            "field": "quand",
            "type": "nominal",
            "title": "Heure"
          },
          {
            "field": "temperature_c",
            "type": "quantitative",
            "title": "Température (°C)",
            "format": ".1f"
          },
          {
            "field": "Taux pénurie",
            "type": "quantitative",
            "title": "Pénurie",
            "format": ".1%"
          },
          {
            "field": "pluie_libelle",
            "type": "nominal",
            "title": "Météo"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "loess": "Taux pénurie",
          "on": "temperature_c",
          "bandwidth": 0.6
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#EAF0FA",
            "strokeWidth": 3,
            "strokeCap": "round",
            "tooltip": null
          },
          "encoding": {
            "x": {
              "field": "temperature_c",
              "type": "quantitative",
              "scale": {
                "zero": false
              },
              "axis": {
                "title": null,
                "grid": false,
                "labelExpr": "datum.value + ' °C'"
              }
            },
            "y": {
              "field": "Taux pénurie",
              "type": "quantitative",
              "scale": {
                "domainMin": 0
              },
              "axis": {
                "format": ".0%",
                "title": null,
                "tickCount": 4
              }
            }
          }
        },
        {
          "transform": [
            {
              "window": [
                {
                  "op": "last_value",
                  "field": "temperature_c",
                  "as": "tmax"
                }
              ],
              "frame": [
                null,
                null
              ],
              "sort": [
                {
                  "field": "temperature_c"
                }
              ]
            },
            {
              "filter": "datum.temperature_c === datum.tmax"
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "text",
                "align": "right",
                "dx": -6,
                "dy": -14,
                "fontSize": 12,
                "fontWeight": 600,
                "color": "#161E2E",
                "stroke": "#161E2E",
                "strokeWidth": 5,
                "text": "tendance lissée",
                "tooltip": null
              },
              "encoding": {
                "x": {
                  "field": "temperature_c",
                  "type": "quantitative",
                  "scale": {
                    "zero": false
                  },
                  "axis": {
                    "title": null,
                    "grid": false,
                    "labelExpr": "datum.value + ' °C'"
                  }
                },
                "y": {
                  "field": "Taux pénurie",
                  "type": "quantitative",
                  "scale": {
                    "domainMin": 0
                  },
                  "axis": {
                    "format": ".0%",
                    "title": null,
                    "tickCount": 4
                  }
                }
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "right",
                "dx": -6,
                "dy": -14,
                "fontSize": 12,
                "fontWeight": 600,
                "color": "#EAF0FA",
                "text": "tendance lissée",
                "tooltip": null
              },
              "encoding": {
                "x": {
                  "field": "temperature_c",
                  "type": "quantitative",
                  "scale": {
                    "zero": false
                  },
                  "axis": {
                    "title": null,
                    "grid": false,
                    "labelExpr": "datum.value + ' °C'"
                  }
                },
                "y": {
                  "field": "Taux pénurie",
                  "type": "quantitative",
                  "scale": {
                    "domainMin": 0
                  },
                  "axis": {
                    "format": ".0%",
                    "title": null,
                    "tickCount": 4
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
