{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "name": "dataset"
  },
  "padding": {
    "top": 10,
    "left": 6,
    "right": 14,
    "bottom": 6
  },
  "transform": [
    {
      "calculate": "datum['Passages pointe temps sec']",
      "as": "val"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "val",
          "as": "maxi"
        }
      ]
    },
    {
      "calculate": "slice(datum.classe_temperature, 3)",
      "as": "libelle"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "survol",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": [
              "classe_temperature"
            ]
          }
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4,
        "stroke": "#161E2E",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "classe_temperature",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": null,
            "grid": false,
            "labelAngle": 0,
            "labelExpr": "slice(datum.label, 3)",
            "labelFontSize": 12,
            "labelColor": "#A9B6CE",
            "labelLimit": 120
          }
        },
        "y": {
          "field": "val",
          "type": "quantitative",
          "scale": {
            "domainMin": 0
          },
          "axis": {
            "format": ".0f",
            "title": null,
            "tickCount": 4
          }
        },
        "color": {
          "condition": {
            "test": "datum.val === datum.maxi",
            "value": "#9AA9C4"
          },
          "value": "#566892"
        },
        "opacity": {
          "condition": {
            "param": "survol",
            "value": 1
          },
          "value": 0.5
        },
        "tooltip": [
          {
            "field": "libelle",
            "type": "nominal",
            "title": "Température"
          },
          {
            "field": "val",
            "type": "quantitative",
            "title": "Passages par compteur (pointe, temps sec)",
            "format": ".1f"
          },
          {
            "field": "Heures pointe temps sec",
            "type": "quantitative",
            "title": "Heures étudiées",
            "format": ",d"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.maxi * 1.7",
          "as": "plafond"
        }
      ],
      "mark": {
        "type": "point",
        "opacity": 0,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "classe_temperature",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": null,
            "grid": false,
            "labelAngle": 0,
            "labelExpr": "slice(datum.label, 3)",
            "labelFontSize": 12,
            "labelColor": "#A9B6CE",
            "labelLimit": 120
          }
        },
        "y": {
          "field": "plafond",
          "type": "quantitative",
          "scale": {
            "domainMin": 0
          },
          "axis": {
            "format": ".0f",
            "title": null,
            "tickCount": 4
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.val === datum.maxi"
        },
        {
          "calculate": "'maximum : ' + replace(format(datum.val, '.1f'), '.', ',')",
          "as": "etiquette"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -6,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#EAF0FA",
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "classe_temperature",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": null,
            "grid": false,
            "labelAngle": 0,
            "labelExpr": "slice(datum.label, 3)",
            "labelFontSize": 12,
            "labelColor": "#A9B6CE",
            "labelLimit": 120
          }
        },
        "y": {
          "field": "val",
          "type": "quantitative",
          "scale": {
            "domainMin": 0
          },
          "axis": {
            "format": ".0f",
            "title": null,
            "tickCount": 4
          }
        },
        "text": {
          "field": "etiquette"
        }
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "last_value",
              "field": "val",
              "as": "derniere"
            }
          ],
          "frame": [
            null,
            null
          ],
          "sort": [
            {
              "field": "classe_temperature"
            }
          ]
        },
        {
          "filter": "datum.derniere < datum.maxi"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "derniere",
              "as": "d"
            }
          ]
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 6,
            "dy": 2,
            "fontSize": 11,
            "color": "#8D9BB6",
            "tooltip": null,
            "text": "la baisse au-delà de 27 °C coïncide"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "value": 0
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 6,
            "dy": 16,
            "fontSize": 11,
            "color": "#8D9BB6",
            "tooltip": null,
            "text": "avec les vacances d'été"
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "value": 0
            }
          }
        }
      ]
    }
  ]
}
